/.quarto/
/_site/

**/*.quarto_ipynb

# Claude Code's per-machine settings — local to this computer, not the project
.claude/

# R session junk
.Rproj.user/
.RData
.Rhistory

# Excel writes these next to a workbook while it is open
~$*

# pdflatex scratch files for the maintenance guide. The .tex and the built
# .pdf are both committed; these four are rewritten on every compile and are
# useless to anyone else. Scoped to /guide/ on purpose — it is the only
# hand-run LaTeX project here, and a bare *.log would swallow unrelated logs.
/guide/*.aux
/guide/*.log
/guide/*.out
/guide/*.toc
/guide/*.fls
/guide/*.fdb_latexmk
/guide/*.synctex.gz

# Everything that is not needed to build or host the site now lives here —
# the legacy cv/ project, the duplicate deck render, and R session junk.
# Kept on disk so nothing is lost; never committed. See archive/README.md.
/archive/

# Both of the entries below moved into archive/ and are kept only so that
# restoring either one does not accidentally add it to the repository.
/cv/
/Rclass_2025/_site/

# Shinylive export of software/app.R — 115 MB of WebAssembly runtime, almost
# none of it shared with anything else in the repo, so git cannot dedupe it.
# Regenerated by software/build-shinylive.R, which the publish workflow runs
# before rendering. app.R remains the source of truth.
/software/splicer-app/
/software/data_cache/
